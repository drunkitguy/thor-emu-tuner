{
  "schemaVersion": 1,
  "emulatorId": "azahar",
  "name": "Azahar",
  "systems": ["n3ds"],
  "supportLevel": "full",
  "packages": [
    { "packageName": "org.azahar_emu.azahar", "label": "Azahar", "source": "https://gitlab.com/es-de/emulationstation-de/-/raw/master/resources/systems/android/es_find_rules.xml" },
    { "packageName": "io.github.lime3ds.android", "label": "Lime3DS (predecessor, same activity class)", "source": "https://gitlab.com/es-de/emulationstation-de/-/raw/master/resources/systems/android/es_find_rules.xml" }
  ],
  "launch": {
    "packageName": "{package}",
    "activity": "org.citra.citra_emu.activities.EmulationActivity",
    "action": "android.intent.action.VIEW",
    "categories": ["android.intent.category.DEFAULT"],
    "data": "{romUri}",
    "mimeType": "application/octet-stream",
    "extras": [],
    "flags": ["NEW_TASK", "CLEAR_TASK", "CLEAR_TOP", "GRANT_READ_URI"],
    "source": "https://gitlab.com/es-de/emulationstation-de/-/raw/master/resources/systems/android/es_systems.xml",
    "notes": "ES-DE: %EMULATOR_AZAHAR% %ACTIVITY_CLEAR_TASK% %ACTIVITY_CLEAR_TOP% %DATA%=%ROMSAF%. The exported EmulationActivity has a VIEW filter with mimeType application/octet-stream and scheme content (https://raw.githubusercontent.com/azahar-emu/azahar/master/src/android/app/src/main/AndroidManifest.xml). EmulationFragment opens the URI with the emulator's own ContentResolver (file descriptor), so a read grant on the URI is required (https://raw.githubusercontent.com/azahar-emu/azahar/master/src/android/app/src/main/java/org/citra/citra_emu/fragments/EmulationFragment.kt)."
  },
  "configTarget": {
    "mode": "globalIniMerge",
    "folderToGrant": "The Azahar user folder you selected when setting up Azahar (Azahar > Settings > shows the user directory). It lives in shared storage and is SAF-grantable.",
    "folderValidation": ["config/config.ini"],
    "pathTemplate": "config/config.ini",
    "gameIdKind": "n3dsTitleId",
    "iniStyle": { "keyValueSeparator": " = ", "boolTrue": "true", "boolFalse": "false" },
    "source": "https://raw.githubusercontent.com/azahar-emu/azahar/master/src/android/app/src/main/jni/config.cpp",
    "notes": "Azahar on Android has NO per-game config (feature request still open: https://github.com/azahar-emu/azahar/issues/38; duplicate https://github.com/azahar-emu/azahar/issues/2128). The only config is <user>/config/config.ini (config.cpp: GetUserPath(ConfigDir) + 'config.ini'; SettingsFile.kt getSettingsFile finds config/config.ini in the SAF user tree: https://raw.githubusercontent.com/azahar-emu/azahar/master/src/android/app/src/main/java/org/citra/citra_emu/features/settings/utils/SettingsFile.kt). The app therefore applies a game's profile by MERGING only the managed keys into config.ini right before launching that game, after saving a one-time pristine backup and a per-apply backup in app-private storage. EmulationActivity.onCreate calls settings.loadSettings() on every launch (https://raw.githubusercontent.com/azahar-emu/azahar/master/src/android/app/src/main/java/org/citra/citra_emu/activities/EmulationActivity.kt). BOOLEAN keys must be written as true/false: the Kotlin parser uses value.toBoolean(), so '1' would read as false (SettingsFile.kt settingFromLine). Integer keys are plain integers. The user must close Azahar before applying (Azahar may rewrite config.ini when its settings screen closes)."
  },
  "settings": [
    {
      "section": "Renderer", "key": "graphics_api", "label": "Graphics API", "type": "enum", "group": "Renderer", "impact": "high",
      "options": [ { "value": "2", "label": "Vulkan (default)" }, { "value": "1", "label": "OpenGL ES" }, { "value": "0", "label": "Software" } ],
      "default": "2",
      "description": "Renderer backend.",
      "keySource": "https://raw.githubusercontent.com/azahar-emu/azahar/master/src/common/settings.h"
    },
    {
      "section": "Renderer", "key": "resolution_factor", "label": "Internal resolution", "type": "enum", "group": "Resolution", "impact": "high",
      "options": [
        { "value": "0", "label": "Auto (window size)" }, { "value": "1", "label": "1x native (400x240)" }, { "value": "2", "label": "2x (800x480)" },
        { "value": "3", "label": "3x (1200x720)" }, { "value": "4", "label": "4x (1600x960)" }, { "value": "5", "label": "5x (2000x1200)" }, { "value": "6", "label": "6x" }
      ],
      "default": "1",
      "description": "Scale of the 3DS screens. 4x is the largest integer scale whose top screen fits the Thor's 1080-pixel height.",
      "keySource": "https://raw.githubusercontent.com/azahar-emu/azahar/master/src/android/app/src/main/jni/default_ini.h"
    },
    {
      "section": "Renderer", "key": "async_shader_compilation", "label": "Async shader compilation", "type": "bool", "group": "Shaders", "impact": "medium",
      "default": "false",
      "description": "Compile shaders on worker threads (Vulkan only). Reduces stutter.",
      "keySource": "https://raw.githubusercontent.com/azahar-emu/azahar/master/src/android/app/src/main/java/org/citra/citra_emu/features/settings/model/BooleanSetting.kt"
    },
    {
      "section": "Renderer", "key": "use_disk_shader_cache", "label": "Disk shader cache", "type": "bool", "group": "Shaders", "impact": "medium",
      "default": "true",
      "description": "Store compiled shaders on disk to reduce stutter next time.",
      "keySource": "https://raw.githubusercontent.com/azahar-emu/azahar/master/src/android/app/src/main/java/org/citra/citra_emu/features/settings/model/BooleanSetting.kt"
    },
    {
      "section": "Renderer", "key": "texture_filter", "label": "Texture filter", "type": "enum", "group": "Enhancements", "impact": "medium",
      "options": [ { "value": "0", "label": "None" }, { "value": "1", "label": "Anime4K" }, { "value": "2", "label": "Bicubic" }, { "value": "3", "label": "ScaleForce" }, { "value": "4", "label": "xBRZ" }, { "value": "5", "label": "MMPX" } ],
      "default": "0",
      "description": "Texture upscaling filter.",
      "keySource": "https://raw.githubusercontent.com/azahar-emu/azahar/master/src/common/settings.h"
    },
    {
      "section": "Core", "key": "cpu_clock_percentage", "label": "CPU clock %", "type": "int", "group": "CPU", "impact": "high",
      "min": 25, "max": 400, "step": 5, "default": "100",
      "description": "Emulated CPU clock. Underclocking can raise speed but may freeze games; overclocking can remove in-game lag.",
      "keySource": "https://raw.githubusercontent.com/azahar-emu/azahar/master/src/android/app/src/main/jni/default_ini.h"
    },
    {
      "section": "Layout", "key": "layout_option", "label": "Screen layout (main display)", "type": "enum", "group": "Dual screen", "impact": "low",
      "options": [ { "value": "0", "label": "Original (stacked)" }, { "value": "1", "label": "Single screen" }, { "value": "2", "label": "Large screen" }, { "value": "3", "label": "Side by side" }, { "value": "4", "label": "Hybrid" }, { "value": "5", "label": "Custom" } ],
      "default": "0",
      "description": "Layout on the Thor's top display. On Android the enum has no SeparateWindows entry, so Hybrid = 4 and Custom = 5.",
      "keySource": "https://raw.githubusercontent.com/azahar-emu/azahar/master/src/common/settings.h"
    },
    {
      "section": "Layout", "key": "secondary_display_layout", "label": "Secondary display layout", "type": "enum", "group": "Dual screen", "impact": "low",
      "options": [ { "value": "0", "label": "System default (mirror)" }, { "value": "1", "label": "Top screen only" }, { "value": "2", "label": "Bottom screen only" }, { "value": "3", "label": "Side by side" }, { "value": "4", "label": "Opposite of primary (Azahar 2126.0+)" }, { "value": "5", "label": "Original" }, { "value": "6", "label": "Hybrid" }, { "value": "7", "label": "Large screen" } ],
      "default": "4",
      "description": "What Azahar shows on the second display (the Thor's bottom screen).",
      "keySource": "https://raw.githubusercontent.com/azahar-emu/azahar/master/src/common/settings.h"
    },
    {
      "section": "Layout", "key": "swap_screen", "label": "Swap screens", "type": "bool", "group": "Dual screen", "impact": "low",
      "default": "false",
      "description": "Makes the 3DS bottom screen the prominent one.",
      "keySource": "https://raw.githubusercontent.com/azahar-emu/azahar/master/src/android/app/src/main/java/org/citra/citra_emu/features/settings/model/BooleanSetting.kt"
    },
    {
      "section": "Layout", "key": "performance_overlay_enable", "label": "Performance overlay", "type": "bool", "group": "Testing", "impact": "low",
      "default": "false",
      "description": "Shows Azahar's FPS/speed overlay for test sessions.",
      "keySource": "https://raw.githubusercontent.com/azahar-emu/azahar/master/src/android/app/src/main/java/org/citra/citra_emu/features/settings/model/BooleanSetting.kt"
    }
  ],
  "presets": [
    {
      "id": "thor-dual-screen",
      "name": "Thor Dual Screen (layout only)",
