    "categories": [],
    "data": null,
    "mimeType": null,
    "extras": [ { "name": "AppStartParameters", "type": "stringArray", "value": "-r,{titleId}" } ],
    "flags": ["NEW_TASK"],
    "source": "https://gitlab.com/es-de/emulationstation-de/-/raw/master/resources/systems/android/es_systems.xml",
    "notes": "ES-DE: %EMULATOR_VITA3K% %EXTRAARRAY_AppStartParameters%=-r,%INJECT%=%BASENAME%.psvita - i.e. a string array ['-r', '<TITLE ID>']. Games must already be installed inside Vita3K; the ROM is a text file '<Game>.psvita' containing the title ID such as PCSF00007 (https://gitlab.com/es-de/emulationstation-de/-/raw/master/USERGUIDE.md)."
  },
  "configTarget": {
    "mode": "manual",
