      "values": [
        { "section": "config.yml", "key": "backend-renderer", "value": "Vulkan", "uiPath": "Settings > GPU > Backend renderer", "uiValue": "Vulkan", "description": "Vulkan (default).",
          "source": "https://raw.githubusercontent.com/Vita3K/Vita3K/master/vita3k/config/include/config/config.h",
          "keySource": "https://raw.githubusercontent.com/Vita3K/Vita3K/master/vita3k/config/include/config/config.h" },
        { "section": "config.yml", "key": "resolution-multiplier", "value": "2.0", "uiPath": "Settings > GPU > Internal resolution", "uiValue": "2x", "description": "960x544 x2 = 1920x1088, matching the Thor top screen.",
          "source": "inferred", "reason": "Integer scale that matches the 1080p panel; no reachable device-specific source.",
          "keySource": "https://raw.githubusercontent.com/Vita3K/Vita3K/master/vita3k/config/include/config/config.h" },
        { "section": "config.yml", "key": "async-pipeline-compilation", "value": "true", "uiPath": "Settings > GPU > Asynchronous pipeline compilation", "uiValue": "On", "description": "Reduces shader stutter (default on).",
          "source": "https://raw.githubusercontent.com/Vita3K/Vita3K/master/vita3k/config/include/config/config.h",
          "keySource": "https://raw.githubusercontent.com/Vita3K/Vita3K/master/vita3k/config/include/config/config.h" },
        { "section": "config.yml", "key": "disable-surface-sync", "value": "true", "uiPath": "Settings > GPU > Disable surface sync", "uiValue": "On", "description": "Speed option (default on).",
          "source": "https://raw.githubusercontent.com/Vita3K/Vita3K/master/vita3k/config/include/config/config.h",
          "keySource": "https://raw.githubusercontent.com/Vita3K/Vita3K/master/vita3k/config/include/config/config.h" }
      ]
    },
    {
      "id": "thor-performance",
      "name": "Thor Performance (manual)",
      "evidence": "inferred",
      "description": "Native resolution for heavy titles.",
      "values": [
        { "section": "config.yml", "key": "resolution-multiplier", "value": "1.0", "uiPath": "Settings > GPU > Internal resolution", "uiValue": "1x", "description": "Native 960x544.",
